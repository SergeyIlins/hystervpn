{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "tag": "proxy",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "www.microsoft.com:443",
          "serverNames": ["www.microsoft.com", "login.live.com"],
          "privateKey": "PRIVATE_KEY_PLACEHOLDER",
          "shortIds": ["SHORT_ID_PLACEHOLDER"]
        }
      }
    },
    {
      "port": 8081,
      "protocol": "vless",
      "tag": "split",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {"mode": "auto", "path": "/stream"}
      }
    }
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "block"}
  ],
  "routing": {
    "rules": [
      {"inboundTag": ["proxy", "split"], "outboundTag": "direct"}
    ]
  }
}
